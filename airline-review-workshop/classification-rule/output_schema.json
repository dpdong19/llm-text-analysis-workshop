{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Airline review classification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "type": "string"
    },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "booking_and_preflight",
              "flight_operations",
              "airport_and_ground_service",
              "seat_and_cabin_comfort",
              "cabin_crew_service",
              "food_and_beverages",
              "inflight_entertainment_and_connectivity",
              "value_for_money",
              "overall_experience",
              "other_or_unclear"
            ]
          },
          "sentiment": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "mixed",
              "neutral_or_unclear"
            ]
          }
        },
        "required": [
          "topic",
          "sentiment"
        ]
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "review_reason": {
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "aspects",
    "review_required"
  ]
}
